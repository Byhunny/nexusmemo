# MemoryOS Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Required: at least one API key
MEMORYOS_OPENAI_API_KEY=sk-your-openai-key-here
# MEMORYOS_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Provider: "openai" or "anthropic"
MEMORYOS_LLM_PROVIDER=openai
MEMORYOS_EXTRACTION_MODEL=gpt-4o-mini

# --- Embeddings ---
# Provider: "openai" (default)
MEMORYOS_EMBEDDING_PROVIDER=openai
MEMORYOS_EMBEDDING_MODEL=text-embedding-3-small
MEMORYOS_EMBEDDING_DIMENSIONS=1536

# --- Data ---
# Where to store the database (default: ~/.memoryos)
# MEMORYOS_DATA_DIR=~/.memoryos

# --- Server ---
MEMORYOS_HOST=127.0.0.1
MEMORYOS_PORT=8765

# --- Retrieval ---
MEMORYOS_MAX_RESULTS=10
MEMORYOS_SIMILARITY_THRESHOLD=0.3
MEMORYOS_GRAPH_EXPANSION_DEPTH=2
