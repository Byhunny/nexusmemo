# NexusMemo Configuration
# Copy this file to .env and fill in your values

# --- Embeddings ---
# FastEmbed is used locally by default. No API key needed.
NEXUSMEMO_EMBEDDING_PROVIDER=fastembed
NEXUSMEMO_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEXUSMEMO_EMBEDDING_DIMENSIONS=384

# --- Data ---
# Where to store the database (default: ~/.nexusmemo)
# NEXUSMEMO_DATA_DIR=~/.nexusmemo

# --- Server ---
NEXUSMEMO_HOST=127.0.0.1
NEXUSMEMO_PORT=8765

# --- Retrieval ---
NEXUSMEMO_MAX_RESULTS=10
NEXUSMEMO_SIMILARITY_THRESHOLD=0.3
NEXUSMEMO_GRAPH_EXPANSION_DEPTH=2
