# NexusMemo Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Required: at least one API key
NEXUSMEMO_OPENAI_API_KEY=sk-your-openai-key-here
# NEXUSMEMO_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Provider: "openai" or "anthropic"
NEXUSMEMO_LLM_PROVIDER=openai
NEXUSMEMO_EXTRACTION_MODEL=gpt-4o-mini

# --- Embeddings ---
# Provider: "openai" (default)
NEXUSMEMO_EMBEDDING_PROVIDER=openai
NEXUSMEMO_EMBEDDING_MODEL=text-embedding-3-small
NEXUSMEMO_EMBEDDING_DIMENSIONS=1536

# --- Data ---
# Where to store the database (default: ~/.nexusmemo)
# NEXUSMEMO_DATA_DIR=~/.nexusmemo

# --- Server ---
NEXUSMEMO_HOST=127.0.0.1
NEXUSMEMO_PORT=8765

# --- Retrieval ---
NEXUSMEMO_MAX_RESULTS=10
NEXUSMEMO_SIMILARITY_THRESHOLD=0.3
NEXUSMEMO_GRAPH_EXPANSION_DEPTH=2
